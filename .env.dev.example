# -----------------------------------------------------------------------------
# Plantilla de variables de entorno para desarrollo local (.env.dev o .env.local)
#
# Copiar este archivo a `.env.dev` (o `.env.local`)
# -----------------------------------------------------------------------------

# Base de datos local (PostgreSQL en Docker via docker compose)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
LOCAL_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Better Auth local
BETTER_AUTH_SECRET=development-better-auth-secret-min-32-chars-long
BETTER_AUTH_URL=http://localhost:3000

# CORS y dominios locales
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Llaves de prueba de Cloudflare Turnstile (pasan siempre en localhost)
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# API local (Vite redirige /api a localhost:8787 automáticamente)
VITE_API_BASE_URL=http://localhost:3000/api

# --- LLM: course matching (OpenRouter) ---
OPENROUTER_API_KEY=
# OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
# COURSE_MATCH_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free, baidu/ernie-5.5-flash-preview:free, particle-ai/particle-1:free
# OPENROUTER_TIMEOUT_SECONDS=20
# OPENROUTER_ATTEMPTS=4

# --- LLM: review summaries (opencode CLI) ---
# OPENCODE_BIN=opencode
# REVIEW_SUMMARY_MODEL=opencode/deepseek-v4.1-flash-free
# REVIEW_SUMMARY_AGENT=professor-reviews-summarizer
# REVIEW_SUMMARY_TIMEOUT_MS=45000
# REVIEW_SUMMARY_CONCURRENCY=16
# REVIEW_SUMMARY_MIN_REVIEWS=10
# REVIEW_SUMMARY_MIN_NEW=5

# --- Daily sync ---
# SYNC_PUSH_BRANCH=development
# SYNC_SKIP_SUMMARIES=0
# SYNC_NO_OPENROUTER=0
