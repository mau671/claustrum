# -----------------------------------------------------------------------------
# Plantilla de variables de entorno para desarrollo local (.env.local o .env)
#
# Copiar este archivo a `.env.local`
# -----------------------------------------------------------------------------

# Base de datos local (PostgreSQL en Docker via docker compose)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
LOCAL_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Better Auth local
BETTER_AUTH_SECRET=development-better-auth-secret-min-32-chars-long
BETTER_AUTH_URL=http://localhost:3000

# CORS y dominios locales
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Llaves de prueba de Cloudflare Turnstile (pasan siempre en localhost)
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# API local (Vite redirige /api a localhost:8787 automáticamente)
VITE_API_BASE_URL=http://localhost:3000/api
