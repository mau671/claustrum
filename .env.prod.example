# -----------------------------------------------------------------------------
# Plantilla para operaciones de producción (.env.prod)
#
# Copiar este archivo a `.env.prod` para ejecutar migraciones o seeds
# remotos contra la base de datos de producción desde tu terminal:
#
#   pnpm run db:migrate -- --prod
#   pnpm run db:seed -- --prod
#   pnpm run db:studio -- --prod
#
# NOTA: Este archivo está en .gitignore y NUNCA debe subirse a Git.
# -----------------------------------------------------------------------------

# Cadena de conexión directa a PostgreSQL de producción (con sslmode=require)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.jxzkhfclcdpcgtkpyxyk.supabase.co:5432/postgres?sslmode=require

# Parámetros de base de datos para despliegues de Alchemy (si ejecutas alchemy deploy localmente)
DB_HOST=db.jxzkhfclcdpcgtkpyxyk.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=hyperdrive_user
DB_PASSWORD=

# Credenciales de Cloudflare para despliegues locales con Alchemy (opcional si usas GitHub Actions)
