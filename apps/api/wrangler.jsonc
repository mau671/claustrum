{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "claustrum-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-20",
  "compatibility_flags": ["nodejs_compat", "no_handle_cross_request_promise_resolution"],
  "r2_buckets": [
    {
      "binding": "EVALUATIONS_BUCKET",
      "bucket_name": "claustrum-evaluations",
    },
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "62aa539cbf034fb6b152b78311dc2084",
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:54322/postgres",
    },
  ],
  "routes": [
    {
      "pattern": "claustrum.maugp.com/api/*",
      "zone_name": "maugp.com",
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
