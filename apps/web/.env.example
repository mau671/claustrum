# -----------------------------------------------------------------------------
# Supabase - Environment Variables Template
#
# This repo uses a single Supabase base URL for the client app:
# - VITE_SUPABASE_URL
# plus a publishable (public) API key:
# - VITE_SUPABASE_PUBLISHABLE_KEY
#
# For privileged server-side operations (seed/admin scripts ONLY), use:
# - SUPABASE_SECRET_KEY
#
# How to use:
# - Copy this file to `.env.local` for local dev
# - For production, set env vars in your deployment platform (Cloudflare Pages)
# -----------------------------------------------------------------------------

# Supabase Project URL (base URL, NO /rest/v1 suffix)
# Local example:  http://127.0.0.1:54321
# Hosted example: https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# Publishable key (safe to expose publicly)
# Format: sb_publishable_...
VITE_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare Turnstile site key (safe to expose publicly)
# Format: 0x4AAAA...
VITE_TURNSTILE_SITE_KEY=

# API Worker base URL (public, client-side)
# Local example: http://localhost:8787
# Production example: https://claustrum-api.your-subdomain.workers.dev
VITE_API_BASE_URL=

# Better Auth public/API base URL (SERVER-ONLY in worker, but same value as worker origin)
# Local example: http://localhost:8787
# Production example: https://claustrum-api.your-subdomain.workers.dev
BETTER_AUTH_URL=

# Better Auth secret (SERVER-ONLY). Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Direct Postgres connection string used by Better Auth and migration scripts.
# Use a Supabase direct or pooler DATABASE_URL. Do not expose publicly.
DATABASE_URL=

# ES256 private JWK imported into Supabase JWT Signing Keys (SERVER-ONLY).
# Keep as single-line JSON. Do not commit a real value.
SUPABASE_JWT_PRIVATE_JWK=

# Optional if the JWK contains kid. Must match the Supabase signing key kid.
SUPABASE_JWT_KEY_ID=

# Optional until Google OAuth is enabled in Google Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend API key for Better Auth transactional emails.
# Sender: Claustrum <noreply@maugp.com>
RESEND_API_KEY=

# Comma-separated origins allowed to call the Worker with credentials.
# Example: http://localhost:3000,https://claustrum.app
CORS_ORIGINS=

# Secret key (SERVER-ONLY, elevated privileges)
# Format: sb_secret_...
# WARNING: DO NOT expose publicly. DO NOT embed in client code.
# Used ONLY for: supabase/scripts/seed.ts and admin operations
SUPABASE_SECRET_KEY=

# Cloudflare Turnstile secret key (SERVER-ONLY)
# Used by the API Worker
TURNSTILE_SECRET_KEY=
