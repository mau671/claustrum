# Variables locales para el frontend web (TanStack Start / React)
# Copiar a apps/web/.env.local para desarrollo local

# Cloudflare Turnstile site key (pública, safe to expose)
# Llave de prueba para desarrollo local: 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# URL base del API Worker (opcional en desarrollo; Vite proxea /api a localhost:8787)
# En desarrollo: dejar vacío o http://localhost:3000/api
# En producción: https://claustrum.maugp.com/api
VITE_API_BASE_URL=
