# -----------------------------------------------------------------------------
# Production Supabase configuration (REMOTE) - Example
#
# Copy this file to `.env.production.local` and fill in values.
# Do NOT commit `.env.production.local` (it is ignored by this repo's .gitignore).
#
# This template intentionally uses:
# - One Supabase base URL for the app (VITE_SUPABASE_URL)
# - One publishable (public) API key (VITE_SUPABASE_PUBLISHABLE_KEY)
# - One server-only elevated API key for admin/seed scripts (SUPABASE_SECRET_KEY)
# -----------------------------------------------------------------------------

# Supabase Project URL (base URL, NO /rest/v1 suffix)
# Example: https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# Publishable key (safe to expose publicly)
# Format: sb_publishable_...
VITE_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare Turnstile site key (safe to expose publicly)
# Format: 0x4AAAA...
VITE_TURNSTILE_SITE_KEY=

# API Worker base URL (public, client-side)
# Example: https://claustrum-api.your-subdomain.workers.dev
VITE_API_BASE_URL=

# Secret key (SERVER-ONLY, elevated)
# Format: sb_secret_...
# NEVER expose this publicly. Do NOT embed in client code.
SUPABASE_SECRET_KEY=

# Cloudflare Turnstile secret key (SERVER-ONLY)
# Used by the API Worker
TURNSTILE_SECRET_KEY=
