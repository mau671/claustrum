{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "claustrum-web",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-07-06",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "claustrum.maugp.com",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": true,
  },
  "services": [
    {
      "binding": "API",
      "service": "claustrum-api",
    },
  ],
}
