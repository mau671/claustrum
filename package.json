{
  "name": "horarios",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:types": "dotenv -e .env -e .env.local -v EXPORT_TYPES=true -- tsx scripts/export-types.ts",
    "db:schema": "dotenv -e .env -e .env.local -v EXPORT_SCHEMA=true -- tsx scripts/export-schema.ts",
    "db:docs": "dotenv -e .env -e .env.local -v EXPORT_DOCS=true -- tsx scripts/export-schema-docs.ts",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@antigravity-skills/cli": "^0.1.2",
    "@dotenvx/dotenvx": "^1.40.1",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "dotenv": "^16.4.7",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.66.0",
    "oxlint-tsgolint": "^0.22.1",
    "pg": "^8.21.0",
    "simple-git-hooks": "^2.13.1",
    "supabase": "^2.120.0",
    "tsx": "^4.22.3",
    "turbo": "^2.11.7",
    "typescript": "^5.9.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "!(*pnpm-lock).{yaml,yml}": [
      "oxfmt --write"
    ],
    "*.{css,html}": [
      "oxfmt --write"
    ]
  },
  "packageManager": "pnpm@12.10.1"
}
