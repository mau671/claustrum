{
  "name": "horarios",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "alchemy dev",
    "plan": "alchemy plan",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy",
    "build": "turbo build",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepare": "simple-git-hooks",
    "db:start": "docker compose up -d",
    "db:stop": "docker compose down",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:studio": "tsx scripts/studio.ts",
    "db:setup": "pnpm run db:start && pnpm run db:migrate && pnpm run db:seed",
    "generate:og": "tsx scripts/generate-og.ts"
  },
  "devDependencies": {
    "@effect/platform": "^0.97.2",
    "@effect/platform-node": "4.0.4",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "alchemy": "2.0.0-beta.83",
    "cf": "1.0.0-beta.16",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "^4.0.4",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.66.0",
    "oxlint-tsgolint": "^0.22.1",
    "pg": "^8.21.0",
    "simple-git-hooks": "^2.13.1",
    "tsx": "^4.22.3",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "!(*pnpm-lock).{yaml,yml}": [
      "oxfmt --write"
    ],
    "*.{css,html}": [
      "oxfmt --write"
    ]
  },
  "packageManager": "pnpm@12.10.1"
}
